{
  "name": "trading-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:config": "node scripts/validate-config.mjs",
    "build": "npm run validate:config && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare:a11y": "node scripts/prepare-axe.mjs",
    "test:e2e": "npm run prepare:a11y && playwright test",
    "test:e2e:functional": "playwright test --grep-invert '@a11y|@visual|@performance|@interaction|@manager-compose'",
    "test:e2e:manager-compose": "playwright test e2e/manager-compose.spec.js --workers=1",
    "test:a11y": "npm run prepare:a11y && playwright test --grep @a11y",
    "test:performance": "playwright test --grep @performance --workers=1",
    "test:interaction": "playwright test --grep @interaction --workers=1",
    "test:visual": "playwright test --grep @visual --workers=1",
    "test:visual:update": "playwright test --grep @visual --workers=1 --update-snapshots",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "check:performance:bundle": "node scripts/check-performance-budget.mjs",
    "check:manager-connection": "node scripts/check-manager-connection.mjs",
    "check:production": "node scripts/check-production-ui.mjs",
    "check:production:routes": "node scripts/check-production-routes.mjs",
    "check:production:interactions": "node scripts/check-production-interactions.mjs"
  },
  "dependencies": {
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
